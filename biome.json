{
  "files": {
    "includes": ["**/*.js", "!!**/node_modules", "!!**/dist", "!!**/build", "!!**/playwright-report", "!!**/test-results", "!!**/blob-report", "!!art-reference"]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noRedundantUseStrict": "off"
      },
      "complexity": {
        "useArrowFunction": "off"
      }
    }
  }
}
