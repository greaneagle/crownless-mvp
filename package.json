{
  "name": "crownless-mvp",
  "version": "2.20.0",
  "private": true,
  "description": "Crownless — HTML5 Canvas party-battle RPG prototype. No runtime dependencies; the only development dependency is Playwright for the browser tests (W-00).",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "test:slow": "node --test \"tests/slow/*.test.js\"",
    "test:all": "npm test && npm run test:slow",
    "test:browser": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "test:visual:update": "playwright test --grep @visual --update-snapshots=all",
    "test:visual:docker": "node scripts/visual-baselines.js",
    "lint": "npx --yes @biomejs/biome@2 lint . && npm run typecheck",
    "typecheck": "npx --yes -p typescript@6.0.3 tsc --noEmit -p tsconfig.json",
    "serve": "npx --yes http-server@14 -p 8123 -c-1",
    "simulate": "node scripts/simulate-campaign.js",
    "simulate:story": "node scripts/simulate-story.js",
    "bench": "node scripts/bench-battle.js",
    "bench:map": "node scripts/bench-map.js",
    "parity": "node scripts/parity.js",
    "economy": "node scripts/economy-report.js",
    "assets": "node scripts/asset-manifest.js",
    "icons": "node scripts/make-icons.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
